# ── Smart Listener configuration ──────────────────────────────────────────
# Copy to .env and adjust. Never commit real private keys.

# Listener identity (set per process: A, B, C or D)
# LISTENER_ID=A

# Source chain (local Hardhat by default)
SOURCE_RPC_URL=http://127.0.0.1:8545
SOURCE_CHAIN_ID=31337
SOURCE_MODE=hardhat
# For Sepolia listener mode, use these instead of the local source values:
# SOURCE_MODE=sepolia
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<project-id>
# SEPOLIA_CHAIN_ID=11155111
# SEPOLIA_ESCROW_ADDRESS=0x...
# SEPOLIA_LISTENER_MNEMONIC=<dedicated listener-only mnemonic>
POLL_INTERVAL_MS=2000
CONFIRMATIONS=1

# Optional overrides (otherwise read from listener/config/deployment.json)
# SENDER_CONTRACT_ADDRESS=
# RECEIVER_MOCK_ADDRESS=
# SEPOLIA_ESCROW_ADDRESS=

# Consensus
# Strict majority required (paper: t >= n/2 + 1). 4 listeners -> 3 votes.
REQUIRED_VOTES=3
TOTAL_LISTENERS=4

# First block listeners scan on startup (0 = replay all; votes are idempotent)
START_BLOCK=0

# Timing
TX_TIMEOUT_MS=60000
MAX_RETRIES=3
RETRY_BACKOFF_MS=2000

# Storage — leave DATABASE_URL unset to use sql.js SQLite (no native build tools)
# DATABASE_URL=postgres://user:pass@localhost:5432/smartlistener
# SQLITE_PATH=./listener/data/smartlistener.db

# Destination: "evm" (real second chain, default), "simulated", or "fabric" (stub)
DESTINATION_TYPE=evm
DEST_RPC_URL=http://127.0.0.1:8546
DESTINATION_ROUTE_ID=simulated-evm-chain
SIMULATED_FAILURE_RATE=0.05

# Settlement timing. c = CONFIRMATIONS; λB = POLL_INTERVAL_MS / 1000 seconds.
# Must satisfy DELTA_A_SECONDS > DELTA_B_SECONDS + c*λB.
DELTA_B_SECONDS=60
BACKUP_GRACE_SECONDS=2
DELTA_A_SECONDS=65

# Fabric (only when DESTINATION_TYPE=fabric)
# FABRIC_CHANNEL=mychannel
# FABRIC_CHAINCODE=receiver
# FABRIC_MSP_ID=Org1MSP
# FABRIC_WALLET_PATH=./fabric-wallet
# FABRIC_GATEWAY_URL=

# API
API_PORT=3001
API_HOST=127.0.0.1

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
